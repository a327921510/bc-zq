DATA_DIR=./data
BACKUP_DIR=./backups
DB_PATH=./data/archive.db
API_HOST=127.0.0.1
API_PORT=8000
# 单域名子路径；与 Nginx location /zq/、前端 Vite base 保持一致
BASE_PATH=/zq
HTTP_TIMEOUT=30

# IP 白名单：生产以 Nginx include ops/allowed_ips.conf 为主
# 需要 FastAPI 应用层兜底时设为 true（与 Nginx 读同一文件）
IP_WHITELIST_ENABLED=false
IP_WHITELIST_PATH=./ops/allowed_ips.conf

# 手动同步频控（秒），降低东财限流风险；CLI 计划任务不受此约束
SYNC_COOLDOWN_SECONDS=120
SYNC_OK_REUSE_SECONDS=600
SYNC_BATCH_GAP_SECONDS=2
SYNC_REQUEST_GAP_SECONDS=0.4
